{
  "_comment": "EV diagnostic protocol map. Sources: (1) evds.sayuk.cloud app.js (field-tested community values), (2) Tata TDS diagnostic databases extracted locally (KPD_EV_BMS.inf, BMS_TacoGotion.mdb, Kratos_BMS_DB.inf, CESL_EV_BMS.INF). All requests are UDS ReadDataByIdentifier (service 0x22) over ISO-TP CAN 500k unless noted. value = raw * factor + offset.",

  "can_channels": {
    "tata_ev":   { "bms_tx": "785", "bms_rx": "78D", "vecu_tx": "7E3", "vecu_rx": "7EB", "alt_vecu": "780", "session": "1003", "protocol": "11-bit 500k (ATSP6)" },
    "mg_saic":   { "bms_tx": "745", "bms_rx": "74D", "gwm_tx": "744", "gwm_rx": "74C", "alt_bms": "7E4/7EC", "session": "1003" },
    "byd":       { "bms_tx": "781", "bms_rx": "789", "session": "1003", "note": "16-bit DIDs in 0x00xx range, little-endian values" },
    "hyundai_kia": { "bms_tx": "7E4", "bms_rx": "7EC", "session": "1003" },
    "mahindra":  { "bms_tx": "7E4", "bms_rx": "7EC", "session": "1003" },
    "obd_broadcast": { "tx": "7DF", "note": "standard OBD-II functional address; mode 09 02 = VIN, mode 01 A6 = odometer (some cars)" }
  },

  "discovery_scan_presets": {
    "tata":             { "headers": ["785","7E3","781","7E0"], "sessions": ["1003","1001"] },
    "mg_sgmw":          { "headers": ["744","7E3","781","780","7E4","745","7E2","7E0","705","18DAF100"], "sessions": ["1003","1001","10C0","1002"] },
    "byd":              { "headers": ["781","7E0","7E2"], "sessions": ["1003","1001"] },
    "hyundai_mahindra": { "headers": ["7E4","7E0","7E2"], "sessions": ["1003","1001"] },
    "all":              { "headers": ["785","7E3","744","781","7E5","745","7E4","780","7E0","7E2","7E1","705","18DAF100","18DAF1F4","18DADBF1"], "sessions": ["1003","1001","10C0","1002","1086"] }
  },

  "tata_ev_bms_dids_field_tested": {
    "_header": "ATSH785 / ATCRA78D, session 1003 — values as used live by evds.sayuk.cloud",
    "3400": { "name": "Pack voltage",      "bytes": 2, "factor": 0.01, "offset": 0,    "unit": "V", "tds_says_factor": 0.1 },
    "3401": { "name": "Pack current",      "bytes": 2, "factor": 0.1,  "offset": -320, "unit": "A" },
    "3402": { "name": "SOC",               "bytes": 2, "factor": 0.1,  "offset": 0,    "unit": "%" },
    "3403": { "name": "SOH",               "bytes": 2, "factor": 0.1,  "offset": 0,    "unit": "%" },
    "3412": { "name": "Pack avg temp",     "bytes": 1, "factor": 1,    "offset": -40,  "unit": "C" },
    "3415": { "name": "Max cell voltage",  "bytes": 2, "factor": 1,    "offset": 0,    "unit": "mV" },
    "3417": { "name": "Min cell voltage",  "bytes": 2, "factor": 1,    "offset": 0,    "unit": "mV" },
    "3419": { "name": "Max-V cell number", "bytes": 1, "factor": 1,    "offset": 0 },
    "341A": { "name": "Min-V cell number", "bytes": 1, "factor": 1,    "offset": 0 },
    "34D5": { "name": "Cell voltage delta","bytes": 2, "factor": 1,    "offset": 0,    "unit": "mV" },
    "3409": { "name": "Aux 12V battery (per site; TDS says: max cell temp, 1 byte, -40 offset)", "bytes": 2, "factor": 0.01, "unit": "V", "conflict": true },
    "340A": { "name": "HV insulation kOhm (per site; TDS says: max temp probe number)", "bytes": 2, "factor": 1, "unit": "kOhm", "conflict": true },
    "A001_on_7E3": { "name": "Odometer (VECU, header 7E3 rx 7EB)", "bytes": 3, "unit": "km" }
  },

