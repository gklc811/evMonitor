  "elm_init_sequence_used_by_site": ["ATE0", "ATL0", "ATH0", "ATCAF1", "ATSP6", "ATST64", "ATAR", "ATSH<hdr>", "ATCRA<rx>", "1003"],

  "vehicle_autodetect_flow": [
    "1. ATSH7DF + mode 09 02 -> VIN (standard OBD)",
    "2. If no VIN: loop headers [7E3, 785, 744, 7E0, 781, 7E4, 745] -> 1003 -> 22F190",
    "3. Match VIN prefix to profile",
    "4. Fingerprint: ATSH785/ATCRA78D + 223402 replies '6234..' => Tata EV; ATSH781 + 220005 => BYD; ATSH744 + 22B046 => MG; 220108 => Windsor; 220101 => Hyundai/Kia"
  ],

  "important_finding_cell_voltages": "The Tata BMS only exposes MIN and MAX cell voltage + their cell numbers via documented DIDs. evds.sayuk.cloud renders the other cells as ESTIMATED (interpolated between min/max, labeled EST). Their extended probe checks DIDs 3420,3421,3422,3425,3430 hoping for multi-frame cell arrays. No public per-cell array DID is known for Tata EVs."
}
