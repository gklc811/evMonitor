  "hyundai_kia_egmp_bms_blocks": {
    "_header": "Hyundai/Kia (Kona, Ioniq 5, EV6, Creta EV likely) — BMS at 7E4/7EC, UDS 22. Community-documented (OVMS/open-source EV projects), the ONE platform with REAL per-cell voltages. Each block is a multi-frame response; cell voltage bytes scale x0.02 V.",
    "0101": { "name": "BMS main block", "contents": "SOC x0.5, charging flags, pack current (signed 2B x0.1 A), pack voltage (2B x0.1 V), max/min cell temp, module temps, max cell V (1B x0.02), min cell V (1B x0.02), max/min cell numbers, aux 12V x0.1, cumulative charge/discharge kWh, operating time", "multiframe": true },
    "0102": { "name": "Cell voltages 1-32",   "decode": "each payload byte x0.02 V", "multiframe": true },
    "0103": { "name": "Cell voltages 33-64",  "decode": "each payload byte x0.02 V", "multiframe": true },
    "0104": { "name": "Cell voltages 65-96",  "decode": "each payload byte x0.02 V", "multiframe": true },
    "010A": { "name": "Cell voltages 97-128 (packs >96S, e.g. Ioniq 5/EV6)", "decode": "each payload byte x0.02 V", "multiframe": true },
    "010B": { "name": "Cell voltages 129-160", "decode": "each payload byte x0.02 V", "multiframe": true },
    "010C": { "name": "Cell voltages 161-192", "decode": "each payload byte x0.02 V", "multiframe": true },
    "0105": { "name": "SOH block", "contents": "SOH 2B x0.1 %, max-deterioration cell #, display SOC", "multiframe": true },
    "0106": { "name": "Cooling/misc block", "multiframe": true },
    "_verify": "Byte offsets within blocks vary by model-year; verify against a known dashboard value on the actual car before shipping decoders."
  },

  "tata_ev_other_ecus": {
    "_header": "Full DID tables in tata-ev-ecu-dids.json (508 DIDs from TDS KPD_EV_* databases). 29-bit ECU addresses from TDS comm tables (CV-style; passenger cars likely use 11-bit equivalents — probe both).",
    "mcu":  { "dids": 158, "highlights": "torque limits, motor speed, coil/inverter temps, phase currents" },
    "obc":  { "dids": 14,  "addr_29bit": "0x1BDAF1E5", "highlights": "$C610 set current, $C612 battery voltage, $C613 output current" },
    "dcdc": { "dids": 21,  "highlights": "$C710 set current, $C712 battery voltage, $C713 output current" },
    "hecu": { "dids": 188, "addr_29bit": "0x1BDAF927", "highlights": "vehicle speed/charge limits config, SOC derate thresholds; $01xx cell-voltage entries are SETPOINTS not live reads" },
    "bcs":  { "dids": 40,  "addr_29bit": "0x1BDAF13A", "highlights": "$FD00/01 water in/out temp, $FD0D-0F compressor speed/current/power, $FD09 pump duty" },
    "obc_dcdc_minda": { "dids": 87, "addr_29bit": "0x1BDAF18F", "highlights": "mirrors $30xx BMS set with confirmed scaling: $3017/$3018 cell V x0.01, $300D pack V x0.1, $300E current x0.1 -600" }
  },

  "vin_prefix_to_model": {
    "_header": "VIN (from 0902 broadcast or 22F190) prefix -> vehicle profile. WMI: MAT=Tata, LGX=BYD, MZ7/LSJ/MAJ/MEX=MG/JSW-SAIC, KMH=Hyundai, MA1=Mahindra.",
    "MAT832": "tata_punch_ev_mr (25 kWh 102S5P)",
    "MAT833": "tata_punch_ev_lr (35 kWh 102S7P)",
    "MAT834_MAT835": "tata_punch_ev_40 (40.4 kWh prismatic)",
    "MAT620_MAT621": "tata_nexon_ev_prime (30.2 kWh 100S6P)",
    "MAT622_MAT623": "tata_nexon_ev_max (40.5 kWh 104S8P)",
    "MAT624": "tata_tiago_ev_mr (19.2 kWh 100S4P)",
    "MAT625": "tata_tiago_ev / tigor LR (24 kWh 100S5P)",
    "MAT635_MAT63x": "tata_nexon_ev_45 (45 kWh 96S prismatic)",
    "MAT636": "tata_curvv_ev_55 (55 kWh 108S1P)",
    "MAT61x": "tata_harrier_ev (65/75 kWh 108S/118S)",
    "LGXC4": "byd_atto_3",
    "LGXC22": "byd_seal",
    "MZ72_or_*W*": "mg_windsor_ev",
    "MZ7_LSJ_MAJ_MEX": "mg_zs_ev_50 (default MG)",
    "KMH": "hyundai_ioniq_5 family",
    "MA1": "mahindra_xuv400"
  },

